# Public site URL (used for canonical links, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://yousha.in

# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_ID=

# Form delivery: every enquiry is POSTed as JSON to this URL (Formspree, Getform,
# Make/Zapier webhook, etc). If empty, enquiries are only logged on the server.
FORM_WEBHOOK_URL=
