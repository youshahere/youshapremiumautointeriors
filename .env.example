# Public site URL (used for canonical links, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://yousha.in

# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_ID=

# Form delivery via Zoho Mail SMTP. Enquiries are emailed to ENQUIRY_TO (default: the SMTP user)
# and customers who leave an email get a short confirmation.
# Use a Zoho *app-specific password* (Zoho Accounts > Security > App Passwords), not the login password.
ZOHO_SMTP_USER=info@yousha.in
ZOHO_SMTP_PASSWORD=
# smtp.zoho.in for India data centre accounts; use smtp.zoho.com if your account is on the .com DC
ZOHO_SMTP_HOST=smtp.zoho.in
ENQUIRY_TO=

# Optional extra: also POST every enquiry as JSON to a webhook (Make, Zapier, Formspree).
FORM_WEBHOOK_URL=
